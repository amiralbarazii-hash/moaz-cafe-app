rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Owner and manager: full access to records, customers and reports.
    function isManager() {
      return signedIn() && (myRole() == 'owner' || myRole() == 'manager');
    }

    // Owner only: roles, users and settings.
    function isOwner() {
      return signedIn() && myRole() == 'owner';
    }

    // Profile: each user reads their own; managers read all.
    // A user creates only their own profile, and only with role "employee".
    // Only the owner changes roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'employee';
      allow update, delete: if isOwner();
    }

    // Price list: everyone signed in reads it (needed to record a sale); managers edit.
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // Customers: employees may add a new customer while recording a sale; only managers read or change them.
    match /customers/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isManager();
    }

    // Records: employees only create (their own). Managers read, edit and delete everything.
    match /sales/{id} {
      allow create: if signedIn() && request.resource.data.employeeId == request.auth.uid;
      allow read, update, delete: if isManager();
    }

    match /purchases/{id} {
      allow create: if signedIn() && request.resource.data.employeeId == request.auth.uid;
      allow read, update, delete: if isManager();
    }

    match /expenses/{id} {
      allow create: if signedIn() && request.resource.data.employeeId == request.auth.uid;
      allow read, update, delete: if isManager();
    }
  }
}
